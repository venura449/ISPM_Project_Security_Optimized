{
  "info": {
    "name": "ISPM - GET /api/employees Security & Role-Based Auth Tests",
    "_postman_id": "ispm-employee-security-test-collection-v2",
    "description": "Comprehensive security and authorization verification suite for GET /api/employees.\n\nCovers:\n1. Unauthenticated requests (OWASP ZAP Finding: Broken Access Control) -> 401\n2. Forged and invalid tokens -> 401\n3. Admin authentication & full employee dataset inspection -> 200\n4. Role-based field filtering (sensitive compensation/salary hidden from non-admin roles) -> 200\n5. Role-based access control (mutating actions forbidden to non-admins) -> 403\n6. Session invalidation upon logout -> 401",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_email",
      "value": "gaya@gmail.com",
      "type": "string"
    },
    {
      "key": "admin_password",
      "value": "Gayasha123@",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "employee_id_code",
      "value": "EMP001",
      "type": "string"
    },
    {
      "key": "employee_password",
      "value": "",
      "type": "string"
    },
    {
      "key": "employee_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Phase 1 - Unauthenticated & Invalid Token Tests (ZAP Vulnerability)",
      "item": [
        {
          "name": "1. GET /api/employees (No Auth - Expected 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            },
            "description": "Verifies that requesting GET /api/employees without any token returns 401 Unauthorized."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Response indicates authorization token required', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(false);",
                  "    pm.expect(jsonData.data).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. GET /api/employees (Forged Bearer Token - Expected 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.jwt.token.here",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized for forged token', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase 2 - Admin Authentication & Full Dataset Access",
      "item": [
        {
          "name": "3. Admin Login (POST /api/auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin login status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('admin_token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Admin GET /api/employees (Full Fields & Credentials Sanitized)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin receives 200 OK with employee records', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Admin can see salary and management fields', function () {",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    if (res.data.length > 0) {",
                  "        pm.expect(res.data[0].salary).to.not.be.undefined;",
                  "        pm.expect(res.data[0].password).to.be.undefined;",
                  "        pm.expect(res.data[0].token_version).to.be.undefined;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase 3 - Role-Based Authorization & Field Filtering (Non-Admin)",
      "item": [
        {
          "name": "5. Admin Generate Employee Password (POST /api/employee-auth/generate-password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employee-auth/generate-password",
              "host": ["{{base_url}}"],
              "path": ["api", "employee-auth", "generate-password"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Password generated successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "    pm.collectionVariables.set('employee_id_code', res.data.employee_id);",
                  "    pm.collectionVariables.set('employee_password', res.data.password);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6. Employee Login (POST /api/employee-auth/login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"{{employee_id_code}}\",\n  \"password\": \"{{employee_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employee-auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "employee-auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Employee login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('employee_token', res.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7. Employee GET /api/employees (Sensitive Fields Filtered)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employee_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Employee receives 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Salary and address are stripped from employee role view', function () {",
                  "    pm.expect(res.data).to.be.an('array');",
                  "    if (res.data.length > 0) {",
                  "        pm.expect(res.data[0].salary).to.be.undefined;",
                  "        pm.expect(res.data[0].address).to.be.undefined;",
                  "        pm.expect(res.data[0].name).to.not.be.undefined;",
                  "        pm.expect(res.data[0].department).to.not.be.undefined;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "8. Employee POST /api/employees (Expected 403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employee_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP999\",\n  \"joining_date\": \"2026-01-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Mutating action blocked with 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Phase 4 - Session Revocation (Logout)",
      "item": [
        {
          "name": "9. Admin Logout (POST /api/auth/logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout succeeds with 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "10. GET /api/employees with Revoked Token (Expected 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/employees",
              "host": ["{{base_url}}"],
              "path": ["api", "employees"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Revoked token is rejected with 401', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
